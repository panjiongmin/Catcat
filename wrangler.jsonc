{
  // One Worker serves the game (static files from dist/) and the /api routes.
  "name": "catcat",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"], "not_found_handling": "single-page-application" },
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNTS", "class_name": "Accounts" },
      { "name": "STREETS", "class_name": "Street" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Accounts", "Street"] }]
}
